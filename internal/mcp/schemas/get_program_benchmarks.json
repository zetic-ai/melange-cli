{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "metrics": {
      "additionalProperties": {
        "items": {
          "properties": {
            "approximate": {
              "description": "Rendered with \"≈\".",
              "title": "Approximate",
              "type": "boolean"
            },
            "better": {
              "enum": [
                "higher",
                "lower"
              ],
              "title": "Better",
              "type": "string"
            },
            "category": {
              "description": "How pages group the metric: `speed`, `memory`, `energy`, `size` or `accuracy`. Open vocabulary.",
              "title": "Category",
              "type": "string"
            },
            "group": {
              "enum": [
                "speed",
                "accuracy"
              ],
              "title": "Group",
              "type": "string"
            },
            "key": {
              "title": "Key",
              "type": "string"
            },
            "keyed_by": {
              "description": "Set for keyed metrics: `prompt_tokens` (keys are prompt lengths) or `test_set` (keys are dataset split names).",
              "title": "Keyed By",
              "type": [
                "string",
                "null"
              ]
            },
            "label": {
              "title": "Label",
              "type": "string"
            },
            "maximum": {
              "title": "Maximum",
              "type": [
                "number",
                "null"
              ]
            },
            "summary": {
              "description": "Shown in the model's summary table.",
              "title": "Summary",
              "type": "boolean"
            },
            "unit": {
              "title": "Unit",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "key",
            "group",
            "label",
            "unit",
            "better",
            "category",
            "keyed_by",
            "summary",
            "approximate",
            "maximum"
          ],
          "title": "ProgramMetricDefinition",
          "type": "object"
        },
        "type": "array"
      },
      "description": "Metric vocabulary per task.",
      "title": "Metrics",
      "type": "object"
    },
    "models": {
      "items": {
        "properties": {
          "description": {
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "order": {
            "title": "Order",
            "type": "integer"
          },
          "results": {
            "description": "In catalog (SoC) order.",
            "items": {
              "properties": {
                "as_of": {
                  "format": "date",
                  "title": "As Of",
                  "type": "string"
                },
                "builds": {
                  "items": {
                    "properties": {
                      "accuracy": {
                        "additionalProperties": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "additionalProperties": {
                                "type": "number"
                              },
                              "type": "object"
                            }
                          ]
                        },
                        "title": "Accuracy",
                        "type": "object"
                      },
                      "artifact": {
                        "anyOf": [
                          {
                            "properties": {
                              "artifact_key": {
                                "title": "Artifact Key",
                                "type": "string"
                              },
                              "repo": {
                                "title": "Repo",
                                "type": "string"
                              }
                            },
                            "required": [
                              "repo",
                              "artifact_key"
                            ],
                            "title": "ProgramBuildArtifact",
                            "type": "object"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "baseline": {
                        "title": "Baseline",
                        "type": "boolean"
                      },
                      "highlight": {
                        "title": "Highlight",
                        "type": "boolean"
                      },
                      "key": {
                        "title": "Key",
                        "type": "string"
                      },
                      "label": {
                        "title": "Label",
                        "type": "string"
                      },
                      "modes": {
                        "description": "Inference modes this build is shown for: `speed`, `accuracy`. Auto follows Speed. At most one build per mode per result (per variant).",
                        "items": {
                          "type": "string"
                        },
                        "title": "Modes",
                        "type": "array"
                      },
                      "notes": {
                        "items": {
                          "type": "string"
                        },
                        "title": "Notes",
                        "type": "array"
                      },
                      "runtime": {
                        "description": "What the build runs on, for example `llama_cpp`; `float_reference` marks the accuracy-only float row. Open vocabulary.",
                        "title": "Runtime",
                        "type": "string"
                      },
                      "speed": {
                        "additionalProperties": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "additionalProperties": {
                                "type": "number"
                              },
                              "type": "object"
                            }
                          ]
                        },
                        "title": "Speed",
                        "type": "object"
                      },
                      "status": {
                        "description": "`measured`, `unsupported` or `not_measured`.",
                        "title": "Status",
                        "type": "string"
                      },
                      "status_note": {
                        "title": "Status Note",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "variant": {
                        "title": "Variant",
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "key",
                      "label",
                      "runtime",
                      "status",
                      "modes",
                      "highlight",
                      "baseline",
                      "speed",
                      "accuracy",
                      "notes"
                    ],
                    "title": "ProgramBuild",
                    "type": "object"
                  },
                  "title": "Builds",
                  "type": "array"
                },
                "highlights": {
                  "items": {
                    "type": "string"
                  },
                  "title": "Highlights",
                  "type": "array"
                },
                "measured_on": {
                  "title": "Measured On",
                  "type": "string"
                },
                "method": {
                  "properties": {
                    "accuracy": {
                      "title": "Accuracy",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "speed": {
                      "title": "Speed",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "title": "ProgramMethod",
                  "type": "object"
                },
                "notes": {
                  "properties": {
                    "accuracy": {
                      "items": {
                        "type": "string"
                      },
                      "title": "Accuracy",
                      "type": "array"
                    },
                    "speed": {
                      "items": {
                        "type": "string"
                      },
                      "title": "Speed",
                      "type": "array"
                    }
                  },
                  "required": [
                    "speed",
                    "accuracy"
                  ],
                  "title": "ProgramNotes",
                  "type": "object"
                },
                "revision": {
                  "title": "Revision",
                  "type": "integer"
                },
                "soc": {
                  "title": "Soc",
                  "type": "string"
                },
                "software": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Software",
                  "type": "object"
                },
                "tables": {
                  "items": {
                    "properties": {
                      "columns": {
                        "items": {
                          "type": "string"
                        },
                        "title": "Columns",
                        "type": "array"
                      },
                      "rows": {
                        "items": {
                          "items": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "type": "array"
                        },
                        "title": "Rows",
                        "type": "array"
                      },
                      "title": {
                        "title": "Title",
                        "type": "string"
                      }
                    },
                    "required": [
                      "title",
                      "columns",
                      "rows"
                    ],
                    "title": "ProgramTable",
                    "type": "object"
                  },
                  "title": "Tables",
                  "type": "array"
                },
                "updated_at": {
                  "format": "date-time",
                  "title": "Updated At",
                  "type": "string"
                }
              },
              "required": [
                "soc",
                "measured_on",
                "as_of",
                "software",
                "method",
                "highlights",
                "builds",
                "notes",
                "tables",
                "revision",
                "updated_at"
              ],
              "title": "ProgramResult",
              "type": "object"
            },
            "title": "Results",
            "type": "array"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "task": {
            "description": "`llm`, `asr`, `tts` or `image_classification`; keys `metrics`.",
            "title": "Task",
            "type": "string"
          },
          "variants": {
            "items": {
              "properties": {
                "key": {
                  "title": "Key",
                  "type": "string"
                },
                "label": {
                  "title": "Label",
                  "type": "string"
                }
              },
              "required": [
                "key",
                "label"
              ],
              "title": "ProgramVariant",
              "type": "object"
            },
            "title": "Variants",
            "type": "array"
          },
          "vendor": {
            "title": "Vendor",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "slug",
          "task",
          "name",
          "order",
          "variants",
          "results"
        ],
        "title": "ProgramModel",
        "type": "object"
      },
      "title": "Models",
      "type": "array"
    },
    "program": {
      "title": "Program",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "targets": {
      "description": "The SoC catalog, in page order.",
      "items": {
        "properties": {
          "device": {
            "properties": {
              "model": {
                "title": "Model",
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "title": "Name",
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "title": "ProgramTargetDevice",
            "type": "object"
          },
          "form_factor": {
            "description": "`wearable`, `phone` or `other`.",
            "title": "Form Factor",
            "type": "string"
          },
          "has_results": {
            "description": "False for a SoC whose results are still to come.",
            "title": "Has Results",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "title": "Notes",
            "type": "array"
          },
          "npu": {
            "title": "Npu",
            "type": [
              "string",
              "null"
            ]
          },
          "soc": {
            "title": "Soc",
            "type": "string"
          }
        },
        "required": [
          "soc",
          "name",
          "form_factor",
          "device",
          "notes",
          "has_results"
        ],
        "title": "ProgramTarget",
        "type": "object"
      },
      "title": "Targets",
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "program",
    "schema_version",
    "metrics",
    "targets",
    "models"
  ],
  "title": "ProgramBenchmarksResponse",
  "type": "object"
}
