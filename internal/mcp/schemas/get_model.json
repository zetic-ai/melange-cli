{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "description": "ModelSummary plus the status endpoint's terminal/download fields and\nthe (lowercase) source type — still NO job args, URIs or HF fields.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "download_ready": {
          "title": "Download Ready",
          "type": "boolean"
        },
        "failure_code": {
          "title": "Failure Code",
          "type": [
            "string",
            "null"
          ]
        },
        "is_default": {
          "title": "Is Default",
          "type": "boolean"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        },
        "state": {
          "enum": [
            "converting",
            "optimizing",
            "ready",
            "failed"
          ],
          "title": "State",
          "type": "string"
        },
        "terminal": {
          "title": "Terminal",
          "type": "boolean"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "version",
        "type",
        "state",
        "is_default",
        "created_at",
        "updated_at",
        "terminal",
        "download_ready",
        "source_type"
      ],
      "title": "ModelDetailResponse",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "get_model envelope returned when include_targets is true.",
      "properties": {
        "model": {
          "description": "ModelSummary plus the status endpoint's terminal/download fields and\nthe (lowercase) source type — still NO job args, URIs or HF fields.",
          "properties": {
            "created_at": {
              "format": "date-time",
              "title": "Created At",
              "type": "string"
            },
            "download_ready": {
              "title": "Download Ready",
              "type": "boolean"
            },
            "failure_code": {
              "title": "Failure Code",
              "type": [
                "string",
                "null"
              ]
            },
            "is_default": {
              "title": "Is Default",
              "type": "boolean"
            },
            "key": {
              "title": "Key",
              "type": "string"
            },
            "source_type": {
              "title": "Source Type",
              "type": "string"
            },
            "state": {
              "enum": [
                "converting",
                "optimizing",
                "ready",
                "failed"
              ],
              "title": "State",
              "type": "string"
            },
            "terminal": {
              "title": "Terminal",
              "type": "boolean"
            },
            "type": {
              "title": "Type",
              "type": "string"
            },
            "updated_at": {
              "format": "date-time",
              "title": "Updated At",
              "type": "string"
            },
            "version": {
              "title": "Version",
              "type": "integer"
            }
          },
          "required": [
            "key",
            "version",
            "type",
            "state",
            "is_default",
            "created_at",
            "updated_at",
            "terminal",
            "download_ready",
            "source_type"
          ],
          "title": "ModelDetailResponse",
          "type": "object"
        },
        "targets": {
          "properties": {
            "count": {
              "title": "Count",
              "type": "integer"
            },
            "results": {
              "items": {
                "description": "One converted target artifact of a model.\n\n`target_id` is OPAQUE and stable — clients must not parse it; pass it\nback to the download endpoints to select this artifact.\n\nThe runtime engine that produced the artifact is deliberately NOT\npublished. Choose between targets on the properties that describe the\nartifact to its consumer: `precision` for general targets, `quant_type`\nfor LLM targets, and `compatibility` for the device it was built for —\nincluding `compatibility.ap_types`, the accelerator classes (cpu/gpu/npu)\nit can run on.\n\n`compatibility` is null when the row carries no device compatibility\ninformation: LLM targets and the all-null sentinel. For those rows no\naccelerator information is published at all, and two artifacts alike in\n`precision` and `quant_type` are distinguishable only by `target_id` and\n`download_size`.",
                "properties": {
                  "compatibility": {
                    "anyOf": [
                      {
                        "properties": {
                          "ap_types": {
                            "items": {
                              "enum": [
                                "cpu",
                                "gpu",
                                "npu"
                              ],
                              "type": "string"
                            },
                            "title": "Ap Types",
                            "type": "array"
                          },
                          "os": {
                            "title": "Os",
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "soc_manufacturer": {
                            "title": "Soc Manufacturer",
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "soc_model": {
                            "title": "Soc Model",
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "ap_types"
                        ],
                        "title": "ModelTargetCompatibility",
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "created_at": {
                    "format": "date-time",
                    "title": "Created At",
                    "type": "string"
                  },
                  "download_size": {
                    "title": "Download Size",
                    "type": "integer"
                  },
                  "kind": {
                    "enum": [
                      "general",
                      "llm"
                    ],
                    "title": "Kind",
                    "type": "string"
                  },
                  "precision": {
                    "enum": [
                      "fp32",
                      "fp16",
                      "int8",
                      null
                    ],
                    "title": "Precision",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "quant_type": {
                    "title": "Quant Type",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "target_id": {
                    "title": "Target Id",
                    "type": "string"
                  }
                },
                "required": [
                  "target_id",
                  "kind",
                  "download_size",
                  "created_at"
                ],
                "title": "ModelTargetItem",
                "type": "object"
              },
              "title": "Results",
              "type": "array"
            }
          },
          "required": [
            "results",
            "count"
          ],
          "title": "ListModelTargetsResponse",
          "type": "object"
        }
      },
      "required": [
        "model",
        "targets"
      ],
      "type": "object"
    }
  ],
  "description": "The model alone, or with include_targets the {\"model\", \"targets\"} envelope.",
  "type": "object"
}
