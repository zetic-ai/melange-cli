            },
            "description": "OK"
          }
        },
        "security": [
          {
            "PublicAuthorizationHeader": []
          }
        ],
        "summary": "List Active Uploads",
        "tags": [
          "uploads"
        ]
      },
      "post": {
        "description": "Start an upload session. Returns presigned PUT URLs for each requested file.",
        "operationId": "zetic_public_uploads_create_upload",
