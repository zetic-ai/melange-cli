    "/v1/projects/{project_name}/uploads": {
      "get": {
        "description": "List active (source IS NULL) upload sessions for the project.\n\nClients should call this before starting a new upload to detect an\nin-flight session and offer recovery options (status, cancel, resume).",
        "operationId": "zetic_public_uploads_list_active_uploads",
        "parameters": [
          {
            "in": "path",
            "name": "project_name",
            "required": true,
            "schema": {
              "title": "Project Name",
              "type": "string"
            }
          }
