        "security": [
          {
            "PublicAuthorizationHeader": []
          }
        ],
        "summary": "Create Upload",
        "tags": [
          "uploads"
        ]
      }
    },
    "/v1/projects/{project_name}/uploads/{upload_id}": {
      "delete": {
        "description": "Cancel an in-flight upload; deletes the row and best-effort removes GCS objects.",
        "operationId": "zetic_public_uploads_cancel_upload",
        "parameters": [
          {
            "in": "path",
            "name": "project_name",
            "required": true,
